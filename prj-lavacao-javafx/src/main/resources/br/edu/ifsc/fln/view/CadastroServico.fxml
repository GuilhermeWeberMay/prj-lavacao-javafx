                        <Label alignment="CENTER_RIGHT" maxHeight="30.0" maxWidth="195.0" minHeight="30.0" minWidth="195.0" prefHeight="30.0" prefWidth="195.0" text="Categoria: " GridPane.rowIndex="4">
