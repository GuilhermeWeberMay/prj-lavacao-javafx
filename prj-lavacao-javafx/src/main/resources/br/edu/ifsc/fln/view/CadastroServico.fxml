                           <font>
                              <Font size="16.0" />
                           </font></Label>
                        <Label fx:id="labelPontosServico" maxHeight="30.0" maxWidth="195.0" minHeight="30.0" minWidth="195.0" prefHeight="30.0" prefWidth="195.0" GridPane.columnIndex="1" GridPane.rowIndex="3">
                           <font>
                              <Font size="16.0" />
