                      <TableColumn fx:id="tableColumnDescricao" maxWidth="133.0" minWidth="133.0" prefWidth="133.0" text="Descrição" />
                        <TableColumn fx:id="tableColumnValor" maxWidth="133.0" minWidth="133.0" prefWidth="133.0" text="Valor" />
                        <TableColumn fx:id="tableColumnCategoria" maxWidth="133.0" minWidth="133.0" prefWidth="133.0" text="Categoria" />
                    </columns>
                  </TableView>
                  <Label alignment="CENTER" contentDisplay="CENTER" layoutX="503.0" prefHeight="27.0" prefWidth="226.0" style="-fx-font-weight: bold;" text="Informações de Serviço">
                     <font>
                        <Font size="18.0" />
                     </font>
                  </Label>
                  <GridPane layoutX="400.0" layoutY="62.0" prefHeight="148.0" prefWidth="390.0">
